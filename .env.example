# ── Storage ───────────────────────────────────────────────────────────────
# Root directory for the Chroma vector index.
PERSISTENT_STORAGE="./storage/cache"
# SQLite catalog holding workspaces, jobs and query history.
CATALOG_DB="./storage/askthesite.db"
# Root directory for crawled markdown, one subdirectory per workspace.
WORKSPACE_ROOT="./workspaces"

# ── LLM providers ─────────────────────────────────────────────────────────
# Default provider: "opensource" (Ollama, no key required), "anthropic" or "openai".
LLM_PROVIDER="opensource"
LLM_MODEL="qwen3.5:4b-mlx"

# Ollama — only needed if it is not on the default localhost port.
OLLAMA_BASE_URL="http://localhost:11434"

# Required only when LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# Required only when LLM_PROVIDER="openai"
OPENAI_API_KEY=""

# ── Optional vector-store backends ────────────────────────────────────────
# Only needed if you swap the store away from the default ChromaDB.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>"
QDRANT_URL="https://<your-cluster-id>.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key-here"

# ── Observability (optional) ──────────────────────────────────────────────
# Set to stream RAG traces to Arize Phoenix / llamatrace.com.
PHOENIX_API_KEY=""

# ── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
# Comma-separated list, or "*" for any origin.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
